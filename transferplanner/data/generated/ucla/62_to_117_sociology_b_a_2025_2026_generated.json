    "academic_year_id": 76,
    "general_information": [
      {
        "type": "GeneralTitle",
        "content": "IMPORTANT MAJOR INFORMATION",
        "groupId": "60bb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 0,
        "area": "General"
      },
      {
        "type": "GeneralText",
        "content": "<p><span style=\";\">Sociology is the study of the organization, dynamics and consequences of social life. The scope of the discipline is as broad and diverse as social life itself. Sociologists study social interaction and relationships, organizations and institutions, communities and whole societies. The methods of sociological investigation are also varied: sociologists immerse themselves in the daily life of groups, interview group participants, examine recorded interaction, interpret historical documents, analyze census data, and conduct large surveys. The methods and concepts of sociology yield powerful insights into the social processes shaping lives, problems and possibilities in contemporary society.</span></p><p><br></p><p>Listed below are the lower division preparation courses for the major. THIS MAJOR IS HIGHLY SELECTIVE. Transfer students must be admitted as Pre-Sociology majors in order to major in Sociology.</p><p><br></p><p>To be considered for this major, you must complete the following courses by the end of the spring before transfer:</p><ul><li>Sociology 1, and</li><li>One Statistics course.</li></ul><p>All courses must be taken for a letter grade.</p><p><br></p><p>For more information regarding this major and UCLA's transfer selection process, visit <u style=\"color: rgb(41, 98, 255);\">https://</u><a href=\"http://www.soc.ucla.edu and?\" rel=\"noopener noreferrer\" target=\"_blank\">www.soc.ucla.edu</a> and <u style=\"color: rgb(41, 98, 255);\">https://</u><a href=\"http://www.admission.ucla.edu.\" rel=\"noopener noreferrer\" target=\"_blank\">admission.ucla.edu.</a></p><p><br></p><p>PLEASE NOTE: the community college courses listed below have been approved to satisfy the preparation requirements for this major at UCLA, but they may not be exact equivalents of the UCLA courses listed.</p>",
        "groupId": "66bb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 1,
        "area": "General"
      },
      {
        "type": "GeneralTitle",
        "content": "Additional Notes",
        "groupId": "59bb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 2,
        "area": "General"
      },
      {
        "type": "GeneralText",
        "content": "<p>The community college statistics course included on this agreement has been approved as a substitute for Statistics 13 which means it may not transfer as an exact UCLA equivalent.</p>",
        "groupId": "5cbb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 3,
        "area": "General"
      },
      {
        "type": "GeneralTitle",
        "content": "AP EXAM CREDIT",
        "groupId": "64bb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 4,
        "area": "General"
      },
      {
        "type": "GeneralText",
        "content": "<p>The AP Exam Scores listed below may be used to satisfy the major prep:</p><ul><li>A score of <strong><u>3 or higher on the AP Statistics exam</u></strong> can be used in place of the Statistics course.</li></ul>",
        "groupId": "5ebb6f45-6887-ef11-8474-000d3a37e3b6",
        "position": 5,
        "area": "General"
      }
    ],
