# Local development: copy this file to .env.local and use your PostgreSQL user.
PGDATABASE=transferplanner
PGUSER=your_postgres_user
PGHOST=/tmp
PGPORT=5432

# Hosted deployment: set DATABASE_URL in the hosting dashboard instead of the
# local PG* settings above. Use the provider's pooled, SSL-enabled connection URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional for Neon when outbound PostgreSQL TCP is unavailable. The default
# remains tcp for local PostgreSQL and Vercel Fluid compute.
# DATABASE_TRANSPORT=http
